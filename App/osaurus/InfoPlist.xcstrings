    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus verwendet das Mikrofon für Spracheingabe und Diktat, transkribiert mit Apple Speech."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Osaurus uses the microphone for voice input and dictation, transcribed with Apple Speech."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus가 FluidAudio를 사용한 온디바이스 음성 텍스트 변환을 위해 마이크를 사용합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus использует микрофон для локальной расшифровки речи с помощью FluidAudio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus 使用麦克风通过 FluidAudio 进行设备端语音转写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus 使用麥克風透過 FluidAudio 進行裝置端語音轉寫。"
          }
        }
      }
    },
    "NSRemindersUsageDescription" : {
      "comment" : "Privacy - Reminders Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus-Plugins können auf deine Erinnerungen zugreifen, um Aufgaben zu lesen und zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Osaurus plugins may access your reminders to read and create tasks."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Osaurus 플러그인이 작업을 읽고 생성하기 위해 미리 알림에 접근할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Плагины Osaurus могут получать доступ к напоминаниям, чтобы читать и создавать задачи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus 插件可能会访问你的提醒事项，以读取和创建任务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Osaurus 插件可能會存取你的提醒事項，以讀取和建立任務。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus verwendet Apple Speech, um Gesprochenes für Chat, Diktat und Aktivierungswörter in Text umzuwandeln. Es bleibt auf diesem Mac, außer du erlaubst in den Spracheinstellungen die Server von Apple."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Osaurus uses Apple Speech to turn what you say into text for chat, dictation and wake words. It stays on this Mac unless you allow Apple's servers in Voice settings."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus는 Apple Speech를 사용해 말한 내용을 채팅, 받아쓰기, 호출어용 텍스트로 바꿉니다. 음성 설정에서 Apple 서버를 허용하지 않는 한 이 Mac에 머무릅니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus использует Apple Speech, чтобы превращать вашу речь в текст для чата, диктовки и слов активации. Всё остаётся на этом Mac, если вы не разрешите серверы Apple в настройках голоса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus 使用 Apple 语音将你说的话转为文字，用于聊天、听写和唤醒词。除非你在语音设置中允许使用 Apple 服务器，否则一切都留在此 Mac 上。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}