          }
        }
      }
    },
    "Underline misspelled words in the chat input and offer corrections on right-click, using your macOS language and dictionary." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstreicht falsch geschriebene Wörter im Chat-Eingabefeld und bietet per Rechtsklick Korrekturen an – mit deiner macOS-Sprache und deinem Wörterbuch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在聊天输入框中为拼写错误的单词加下划线，并在右键菜单中提供更正，使用你的 macOS 语言和词典。"
          }
        }
      }
    },
    "Underline misspelled words in the chat input and offer suggestions on right-click. Text is never corrected automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falsch geschriebene Wörter in der Chat-Eingabe unterstreichen und per Rechtsklick Vorschläge anbieten. Text wird nie automatisch korrigiert."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在聊天输入框中为拼写错误的单词加下划线，并在右键时提供建议。文本永远不会被自动更正。"
          }
        }
      }
    },
    "Unnamed contact" : {
      "localizations" : {
