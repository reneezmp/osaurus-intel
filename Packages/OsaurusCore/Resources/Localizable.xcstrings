    },
    "Let agents use built-in and plugin tools. Turn off to send messages directly to the model with no tool specs or capability injection (chat-only)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Let agents use built-in and plugin tools. Turn off to send messages directly to the model with no tool specs or capability injection (chat-only)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 내장 및 플러그인 도구를 사용하도록 허용합니다. 도구 사양이나 기능 주입 없이 모델에 메시지를 직접 보내려면 끕니다(채팅 전용)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите агентам использовать встроенные и подключаемые инструменты. Отключите этот параметр, чтобы отправлять сообщения непосредственно в модель без каких-либо спецификаций инструмента или внедрения возможностей (только чат)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许智能体使用内置工具和插件工具。关闭此选项，则消息将直接发送给模型，不附带任何工具规格或能力注入（纯聊天模式）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許智能體使用內置工具和插件工具。關閉此選項，則消息將直接發送給模型，不附帶任何工具規格或能力注入（純聊天模式）。"
          }
        }
      }
    },
    "Let requests run with no time limit" : {
      "localizations" : {
