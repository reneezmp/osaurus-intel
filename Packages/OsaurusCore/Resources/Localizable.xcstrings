        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在不共享密码的情况下允许工具接入"
          }
        }
      }
    },
    "Lets your dino install packages, run scripts, and work with files like a real machine." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt deinen Dino Pakete installieren, Skripte ausführen und mit Dateien arbeiten wie ein echter Computer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让你的小恐龙像一台真正的机器一样安装软件包、运行脚本并处理文件。"
          }
        }
      }
    },
