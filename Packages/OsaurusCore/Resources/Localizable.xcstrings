    "%@ says your account doesn't include this. It may need a paid plan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laut %@ ist dies in Ihrem Konto nicht enthalten. Möglicherweise ist ein kostenpflichtiger Tarif nötig."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 따르면 계정에 이 기능이 포함되어 있지 않습니다. 유료 요금제가 필요할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По данным %@, ваша учётная запись этого не включает. Возможно, нужен платный тариф."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 表示您的账户不包含此功能，可能需要付费方案。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 表示您的帳戶不包含此功能，可能需要付費方案。"
          }
        }
      }
    },
    "%@ took too long to respond. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat zu lange für eine Antwort gebraucht. Versuchen Sie es gleich noch einmal."
