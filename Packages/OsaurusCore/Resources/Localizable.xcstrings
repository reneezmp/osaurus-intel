      }
    },
    "One summary row per record (no message bodies). Best for spreadsheets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Zusammenfassungszeile pro Eintrag (ohne Nachrichteninhalte). Ideal für Tabellen."
