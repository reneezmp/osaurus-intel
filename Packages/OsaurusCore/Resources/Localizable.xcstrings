          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4efb\u4f55\u62e5\u6709\u6b64\u94fe\u63a5\u7684\u4eba\u90fd\u53ef\u4ee5\u5b89\u88c5\u6b64\u4e3b\u9898\u3002\u4e3b\u9898 JSON \u662f\u516c\u5f00\u7684\u2014\u2014\u8bf7\u52ff\u5728\u81ea\u5b9a\u4e49\u4e3b\u9898\u4e2d\u5206\u4eab\u5bc6\u94a5\u3002"
          }
        }
      }
