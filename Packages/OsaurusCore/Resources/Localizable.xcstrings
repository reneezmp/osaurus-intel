    "Available settings inherit the model and provider defaults. Switch a setting to Custom to override it for this agent only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfügbare Einstellungen übernehmen die Standardwerte von Modell und Anbieter. Stelle eine Einstellung auf „Benutzerdefiniert“, um sie nur für diesen Agenten zu überschreiben."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用设置会继承模型和服务商的默认值。将某项设置切换为“自定义”，即可仅为此智能体覆盖它。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 가능한 설정은 모델과 제공업체의 기본값을 상속해요. 설정을 ‘사용자 지정’으로 바꾸면 이 에이전트에만 재정의해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступные настройки наследуют значения модели и провайдера по умолчанию. Переключите настройку на «Своё», чтобы переопределить её только для этого агента."
          }
        }
      }
    },
