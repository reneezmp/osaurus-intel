    "Fill these in only for servers that don't advertise OAuth metadata. Both the authorize and token URLs must be set to skip discovery.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fclle diese nur f\u00fcr Server aus, die keine OAuth-Metadaten bereitstellen. Sowohl die Authorize- als auch die Token-URL m\u00fcssen gesetzt sein, um die Erkennung zu \u00fcberspringen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ec5\u4e3a\u4e0d\u516c\u5e03 OAuth \u5143\u6570\u636e\u7684\u670d\u52a1\u5668\u586b\u5199\u8fd9\u4e9b\u5185\u5bb9\u3002\u5fc5\u987b\u540c\u65f6\u8bbe\u7f6e\u6388\u6743 URL \u548c\u4ee4\u724c URL \u624d\u80fd\u8df3\u8fc7\u53d1\u73b0\u8fc7\u7a0b\u3002"
