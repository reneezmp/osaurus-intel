        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osaurus 需要人工智能才能工作——要么是云提供商，要么是本地模型。"
          }
        }
      }
    },
    "Osaurus only runs MLX models. Try a repo from `OsaurusAI` or `mlx-community`." : {
