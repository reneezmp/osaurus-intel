    "%@ didn't allow this. Your account may not have access, or you may need to sign in again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat dies nicht erlaubt. Ihr Konto hat möglicherweise keinen Zugriff, oder Sie müssen sich erneut anmelden."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 이 작업을 허용하지 않았습니다. 계정에 접근 권한이 없거나 다시 로그인해야 할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не разрешил это действие. Возможно, у вашей учётной записи нет доступа или нужно войти снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不允许此操作。您的账户可能没有访问权限，或者需要重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不允許此操作。您的帳戶可能沒有存取權限，或者需要重新登入。"
          }
        }
      }
    },
    "%@ didn't answer at this address. The service may have moved; check the URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat unter dieser Adresse nicht geantwortet. Der Dienst ist möglicherweise umgezogen; prüfen Sie die URL."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이 주소에서 응답하지 않았습니다. 서비스가 이전되었을 수 있으니 URL을 확인하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не ответил по этому адресу. Возможно, сервис переехал — проверьте URL."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未在此地址响应。服务可能已迁移，请检查 URL。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未在此位址回應。服務可能已遷移，請檢查 URL。"
          }
        }
      }
    },
    "%@ is having problems right now. Try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat gerade Probleme. Versuchen Sie es später erneut."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 현재 문제가 있습니다. 나중에 다시 시도하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@ сейчас неполадки. Повторите попытку позже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 目前出现问题，请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 目前發生問題，請稍後再試。"
          }
        }
      }
    },
    "%@ needs more information" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ benötigt weitere Angaben"
          }
        },
