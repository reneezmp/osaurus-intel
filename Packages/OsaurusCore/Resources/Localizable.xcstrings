    "Backfill cancelled after %lld session(s) — %lld turns buffered. Run 'Distill pending' to drain them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Backfill abgebrochen nach %1$lld Sitzung(en) — %2$lld Runden gepuffert. Führe 'Distill pending' aus, um sie zu leeren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Backfill cancelled after %1$lld session(s) — %2$lld turns buffered. Run 'Distill pending' to drain them."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld개 세션 후 백필이 취소되었습니다. — %2$lld개 턴이 버퍼링되었습니다. 이를 비우려면 '대기 중인 항목 추출'을 실행하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заполнение отменено после %1$lld сеансов — %2$lld оказывается в буфере. Запустите «Ожидание дистилляции», чтобы слить их."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %1$lld 个会话后取消回填 —— 已缓冲 %2$lld 次轮询。运行“Distill pending”以释放它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %1$lld 個會話後取消回填 —— 已緩衝 %2$lld 次輪詢。運行「Distill pending」以釋放它們。"
          }
        }
      }
    },
