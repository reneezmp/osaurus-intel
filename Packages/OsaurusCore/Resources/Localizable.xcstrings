    "Backfill cancelled after %@ — %@ buffered. Run 'Distill pending' to drain them." : {
      "comment" : "A message displayed in the \"Backfill complete\" banner when a memory backfill is cancelled mid-process.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Backfill cancelled after %1$@ — %2$@ buffered. Run 'Distill pending' to drain them."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Backfill cancelled after %1$@ — %2$@ buffered. Run 'Distill pending' to drain them."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Backfill cancelled after %1$@ — %2$@ buffered. Run 'Distill pending' to drain them."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
