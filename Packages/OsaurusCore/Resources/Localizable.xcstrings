    "Discover and install more themes shared by the Osaurus community" : {
      "comment" : "A description of the benefits of exploring and installing themes shared by the Osaurus community.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
