            "state": "translated",
            "value": "AI"
          }
        }
      }
    },
    "Runs on your Mac. Your chats, files, and keys stay with you. No account, no cloud required.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4uft auf deinem Mac. Deine Chats, Dateien und Schl\u00fcssel bleiben bei dir. Kein Konto, keine Cloud n\u00f6tig."
          }
