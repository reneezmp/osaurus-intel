            "value": "\u4f60"
          }
        }
      }
    },
    "You can change this anytime in Settings \u2192 Privacy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dies jederzeit unter Einstellungen \u2192 Datenschutz \u00e4ndern."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u53ef\u4ee5\u968f\u65f6\u5728\u300c\u8bbe\u7f6e \u2192 \u9690\u79c1\u300d\u4e2d\u66f4\u6539\u6b64\u8bbe\u7f6e\u3002"
          }
        }
      }
    },
    "You can rename and customize your dino anytime in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst deinen Dino jederzeit in den Einstellungen umbenennen und anpassen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u53ef\u4ee5\u968f\u65f6\u5728\u8bbe\u7f6e\u4e2d\u91cd\u547d\u540d\u548c\u81ea\u5b9a\u4e49\u4f60\u7684\u6050\u9f99\u3002"
          }
        }
      }
    },
    "You may be asked to authenticate to sign the upload.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst m\u00f6glicherweise aufgefordert, dich zu authentifizieren, um den Upload zu signieren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7cfb\u7edf\u53ef\u80fd\u4f1a\u8981\u6c42\u4f60\u8fdb\u884c\u8eab\u4efd\u9a8c\u8bc1\u4ee5\u7b7e\u7f72\u6b64\u6b21\u4e0a\u4f20\u3002"
          }
        }
      }
    },
    "You were renaming a conversation titled \"%@\" to \"%@\" but haven't saved it yet.": {
      "comment": "Message in an alert that appears when a user attempts to rename a chat session but hasn't saved the new title yet.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast eine Unterhaltung mit dem Titel \u201e%1$@\u201c in \u201e%2$@\u201c umbenannt, aber noch nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You were renaming a conversation titled \"%1$@\" to \"%2$@\" but haven't saved it yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u6b63\u5728\u5c06\u6807\u9898\u4e3a\u201c%1$@\u201d\u7684\u5bf9\u8bdd\u91cd\u547d\u540d\u4e3a\u201c%2$@\u201d\uff0c\u4f46\u5c1a\u672a\u4fdd\u5b58\u3002"
          }
        }
      }
    },
    "You're already set up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist bereits eingerichtet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5df2\u7ecf\u8bbe\u7f6e\u5b8c\u6bd5"
          }
        }
      }
    },
    "Your API key is stored in your macOS Keychain and only sent to %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein API-Schl\u00fcssel wird in deinem macOS-Schl\u00fcsselbund gespeichert und nur an %@ gesendet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684 API \u5bc6\u94a5\u5b58\u50a8\u5728\u4f60\u7684 macOS \u94a5\u5319\u4e32\u4e2d\uff0c\u4e14\u4ec5\u53d1\u9001\u7ed9 %@\u3002"
          }
        }
      }
    },
    "Your API key never leaves your device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein API Key verl\u00e4sst nie dein Ger\u00e4t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7684 API \u5bc6\u94a5\u6c38\u8fdc\u4e0d\u4f1a\u79bb\u5f00\u60a8\u7684\u8bbe\u5907\u3002"
          }
        }
      }
    },
    "Your API keys are stored securely in Keychain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine API Keys sind sicher im Schl\u00fcsselbund gespeichert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7684 API \u5bc6\u94a5\u5b89\u5168\u5730\u5b58\u50a8\u5728\u94a5\u5319\u4e32\u4e2d\u3002"
          }
        }
      }
    },
    "Your chats, prompts, files, and keys never leave your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Chats, Prompts, Dateien und Schl\u00fcssel verlassen niemals deinen Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u804a\u5929\u3001\u63d0\u793a\u8bcd\u3001\u6587\u4ef6\u548c\u5bc6\u94a5\u7edd\u4e0d\u4f1a\u79bb\u5f00\u4f60\u7684 Mac\u3002"
          }
        }
      }
    },
    "Your Client Secret is stored in your macOS Keychain and only sent to %@.": {
      "comment": "A message below the text fields that",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Client-Secret wird in deinem macOS-Schl\u00fcsselbund gespeichert und nur an %@ gesendet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u7684\u5ba2\u6237\u7aef\u5bc6\u94a5\u5b58\u50a8\u5728\u4f60\u7684 macOS \u94a5\u5319\u4e32\u4e2d\uff0c\u4e14\u4ec5\u53d1\u9001\u7ed9 %@\u3002"
          }
        }
      }
    },
    "Your current Master Key no longer matches the addresses your agents and access keys were derived from. This usually means a Master Key was created on top of an existing one \u2014 for example, by a re-run of onboarding.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein aktueller Hauptschl\u00fcssel passt nicht mehr zu den Adressen, von denen deine Agenten und Zugriffsschl\u00fcssel abgeleitet wurden. Das bedeutet normalerweise, dass ein Hauptschl\u00fcssel \u00fcber einem vorhandenen erstellt wurde \u2013 zum Beispiel durch ein erneutes Onboarding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f60\u5f53\u524d\u7684\u4e3b\u5bc6\u94a5\u4e0d\u518d\u4e0e\u4f60\u7684\u667a\u80fd\u4f53\u548c\u8bbf\u95ee\u5bc6\u94a5\u6240\u6d3e\u751f\u7684\u5730\u5740\u76f8\u5339\u914d\u3002\u8fd9\u901a\u5e38\u610f\u5473\u7740\u5728\u73b0\u6709\u4e3b\u5bc6\u94a5\u4e4b\u4e0a\u53c8\u521b\u5efa\u4e86\u4e00\u4e2a\u4e3b\u5bc6\u94a5\u2014\u2014\u4f8b\u5982\uff0c\u7531\u4e8e\u91cd\u65b0\u6267\u884c\u4e86\u521d\u59cb\u8bbe\u7f6e\u3002"
          }
        }
      }
