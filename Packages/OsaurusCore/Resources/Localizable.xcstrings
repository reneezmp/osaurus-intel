    "Running on the host means this subprocess can access your files, network, and credentials. Only use Host for tools you trust." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ausführung auf dem Host bedeutet, dass dieser Unterprozess auf deine Dateien, dein Netzwerk und deine Anmeldedaten zugreifen kann. Verwende „Host“ nur für Tools, denen du vertraust."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트에서 실행하면 이 하위 프로세스가 파일, 네트워크 및 자격 증명에 접근할 수 있습니다. 신뢰하는 도구에만 호스트를 사용하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запуск на хосте означает, что этот подпроцесс может получить доступ к вашим файлам, сети и учётным данным. Используйте Host только для инструментов, которым вы доверяете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在主机上运行意味着此子进程可以访问你的文件、网络和凭据。仅对你信任的工具使用“主机”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在主機上運行意味着此子進程可以訪問你的文件、網絡和憑據。僅對你信任的工具使用「主機」。"
          }
        }
      }
    },
