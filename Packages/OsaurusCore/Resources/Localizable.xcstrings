      }
    },
    "This language can't be recognised on this Mac. Allow Apple's servers below, or pick another language." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sprache kann auf diesem Mac nicht erkannt werden. Erlaube unten die Server von Apple oder wähle eine andere Sprache."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 无法识别该语言。请在下方允许使用 Apple 服务器，或选择其他语言。"
          }
        }
      }
    },
    "This language uses Apple's servers: your speech is sent to Apple to be transcribed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sprache nutzt die Server von Apple: Deine Sprache wird zur Transkription an Apple gesendet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该语言使用 Apple 服务器：你的语音会发送给 Apple 进行转写。"
          }
        }
      }
    },
    "This permanently deletes every table, row, and saved view this agent has stored, and its database history. The agent and its settings stay. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Tabellen, Zeilen und gespeicherten Ansichten dieses Agenten sowie sein Datenbankverlauf dauerhaft gelöscht. Der Agent und seine Einstellungen bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除此智能体存储的所有表、行和已保存视图，以及其数据库历史记录。智能体及其设置会保留。此操作无法撤销。"
          }
        }
      }
    },
    "Ticket #%lld: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ticket #%1$lld: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工单 #%1$lld：%2$@"
          }
        }
      }
    },
    "Try a different term, like “hotkey” or “spelling”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuche einen anderen Begriff, etwa „Tastenkürzel“ oder „Rechtschreibung“."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试试其他词，例如“快捷键”或“拼写”。"
          }
        }
      }
    },
    "Turn off Follow System Accent to choose a custom accent color." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiviere „Systemakzentfarbe verwenden“, um eine eigene Akzentfarbe zu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off Follow System Accent to choose a custom accent color."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 지정 강조 색상을 선택하려면 시스템 강조 색상 따르기를 끄세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключите «Использовать системный акцент», чтобы выбрать свой цвет акцента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭“跟随系统强调色”以选择自定义强调色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉「跟隨系統強調色」以選擇自訂強調色。"
          }
        }
      }
    },
    "Turned off in System Settings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den Systemeinstellungen ausgeschaltet"
          }
