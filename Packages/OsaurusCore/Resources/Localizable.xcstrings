          "stringUnit": {
            "state": "translated",
            "value": "\u7559\u7a7a\u4ee5\u4ec5\u4f7f\u7528\u4ee3\u7406\u540d\u79f0\u4f5c\u4e3a\u5524\u9192\u8bcd"
          }
        }
      }
    },
    "Leave empty to use default values from global settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um Standardwerte aus den globalen Einstellungen zu verwenden."
