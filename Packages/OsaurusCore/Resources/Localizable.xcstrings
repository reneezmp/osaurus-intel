    "Maximum consecutive tool calls per turn before the agent must answer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale aufeinanderfolgende Tool-Aufrufe pro Runde, bevor der Agent antworten muss."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 답변하기 전에 한 턴에서 연속으로 호출할 수 있는 최대 도구 수입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимум последовательных вызовов инструментов за ход, после которого агент должен ответить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能体必须作答前，每轮可连续调用工具的最大次数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能體必須回答前，每輪可連續呼叫工具的最大次數。"
          }
        }
      }
    },
    "Maximum response tokens for the Orchestrator when it has no value of its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Antwort-Tokens für den Orchestrator, wenn er keinen eigenen Wert hat."
