        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhergestellt aus %@. Die Cloud hat nur den Platzhalter gesehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored from %@. The cloud only saw the placeholder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u4ece %@ \u8fd8\u539f\u3002\u4e91\u7aef\u53ea\u770b\u5230\u4e86\u5360\u4f4d\u7b26\u3002"
          }
        }
      }
    },
    "privacy.highlight.a11y.outbound": {
      "comment": "VoiceOver label for inline-highlighted text in a USER bubble whose original was scrubbed before send. %@ is the placeholder token (e.g. [PHONE_1]) the cloud actually saw.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als %@ an die Cloud gesendet. Das Original bleibt auf diesem Ger\u00e4t."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent to cloud as %@. The original stays on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ee5 %@ \u5f62\u5f0f\u53d1\u9001\u5230\u4e91\u7aef\u3002\u539f\u59cb\u5185\u5bb9\u4fdd\u7559\u5728\u6b64\u8bbe\u5907\u4e0a\u3002"
          }
        }
      }
    },
    "privacy.highlight.a11y.preview": {
      "comment": "VoiceOver label for highlighted placeholder tokens in the review sheet's scrubbed preview. %@ is the original value the placeholder replaces (e.g. an email or phone number), shown so screen readers can announce what's being hidden from the cloud.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platzhalter ersetzt %@. Das Original bleibt auf diesem Ger\u00e4t."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Placeholder replacing %@. The original stays on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5360\u4f4d\u7b26\u66ff\u6362\u4e86 %@\u3002\u539f\u59cb\u5185\u5bb9\u4fdd\u7559\u5728\u6b64\u8bbe\u5907\u4e0a\u3002"
          }
        }
      }
    },
    "privacy.install.subtitle": {
      "comment": "Idle-state subtitle of the Privacy Filter install hero. Sets expectations on size and on-device runtime before the user clicks Install.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa 2,8 GB. L\u00e4uft vollst\u00e4ndig auf diesem Mac \u2013 kein Drittanbieter-Datenverkehr f\u00fcr die Erkennung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About 2.8 GB. Runs entirely on this Mac \u2014 no third-party traffic for detection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ea6 2.8 GB\u3002\u5b8c\u5168\u5728\u6b64 Mac \u4e0a\u8fd0\u884c\u2014\u2014\u68c0\u6d4b\u8fc7\u7a0b\u6ca1\u6709\u4efb\u4f55\u7b2c\u4e09\u65b9\u6d41\u91cf\u3002"
          }
        }
      }
    },
    "privacy.install.subtitle.downloading": {
      "comment": "Subtitle of the install hero while bundle files are streaming. Reassures the user the data path is direct (HuggingFace) rather than via an Osaurus server.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamt das Bundle von Hugging Face."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming the bundle from Hugging Face."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5728\u4ece Hugging Face \u6d41\u5f0f\u4e0b\u8f7d\u6346\u7ed1\u5305\u3002"
          }
        }
      }
    },
    "privacy.install.subtitle.enumerating": {
      "comment": "Subtitle of the install hero during the brief file-list lookup before downloads start.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt Hugging Face ab, welche Dateien dieses Bundle ausliefert."
          }
