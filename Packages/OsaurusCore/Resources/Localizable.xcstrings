    "Override the base URL to route through a proxy or self-hosted gateway. Leave as-is for the official endpoint.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00dcberschreibe die Basis-URL, um \u00fcber einen Proxy oder ein selbst gehostetes Gateway zu leiten. F\u00fcr den offiziellen Endpunkt unver\u00e4ndert lassen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8986\u76d6\u57fa\u7840 URL \u4ee5\u901a\u8fc7\u4ee3\u7406\u6216\u81ea\u6258\u7ba1\u7f51\u5173\u8def\u7531\u3002\u82e5\u4f7f\u7528\u5b98\u65b9\u7aef\u70b9\uff0c\u8bf7\u4fdd\u6301\u4e0d\u53d8\u3002"
