    },
    "The bundle has the required local files. Runtime quality still depends on model-family support and live generation proof." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Bundle enthält die erforderlichen lokalen Dateien. Die Laufzeitqualität hängt weiterhin von der Modellfamilienunterstützung und dem Live-Generierungsnachweis ab."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번들에 필요한 로컬 파일이 있습니다. 런타임 품질은 여전히 모델 제품군 지원 및 실시간 생성 증명에 따라 달라집니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В комплекте есть необходимые локальные файлы. Качество выполнения по-прежнему зависит от поддержки семейства моделей и проверки живого поколения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "捆绑包包含所需的本地文件。运行时质量仍取决于模型系列支持和实时生成证明。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "捆綁包包含所需的本地文件。運行時質量仍取決於模型系列支持和實時生成證明。"
          }
        }
      }
    },
    "The chat is still running a command — revert is paused until it finishes." : {
      "localizations" : {
        "de" : {
