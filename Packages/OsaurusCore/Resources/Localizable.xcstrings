    "Up to 4 runs/day · at most once an hour · quiet 10pm–7am." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu 4 Läufe/Tag · höchstens einmal pro Stunde · Ruhezeit 22–7 Uhr."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
