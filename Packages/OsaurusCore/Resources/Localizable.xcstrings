    "Summarized by %@. The visible chat is unchanged; the model sees this summary in place of the messages above." : {
      "comment" : "A tooltip for the \"Older messages summarized\" section. The argument is the name of the LLM model.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusammengefasst von %@. Der sichtbare Chat bleibt unverändert; das Modell sieht diese Zusammenfassung anstelle der Nachrichten darüber."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 요약함. 보이는 채팅은 바뀌지 않으며, 모델은 위 메시지 대신 이 요약을 봅니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сводка от %@. Видимый чат не меняется; модель видит эту сводку вместо сообщений выше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 %@ 总结。可见的聊天不变；模型会看到此摘要，而不是上面的消息。"
          }
        }
      }
    },
    "Summarizes older messages with %@ to free up context. The visible chat is unchanged." : {
      "comment" : "Helper text under the Compact conversation button. %@ is the configured compaction model name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasst ältere Nachrichten mit %@ zusammen, um Kontext freizugeben. Der sichtbare Chat bleibt unverändert."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 모델로 이전 메시지를 요약하여 컨텍스트를 확보합니다. 표시되는 채팅은 변경되지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Суммирует старые сообщения с помощью %@, чтобы освободить контекст. Видимый чат не меняется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 %@ 总结较早的消息以释放上下文。可见的聊天内容保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 %@ 摘要較早的訊息以釋放上下文。可見的聊天內容保持不變。"
          }
        }
      }
    },
    "Summarizes older messages with the current chat model to free up context. The visible chat is unchanged. Pick a dedicated model in Settings → Conversation → Advanced → Compaction Model." : {
      "comment" : "Text describing the effect of using a different model for context compaction.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasst ältere Nachrichten mit dem aktuellen Chat-Modell zusammen, um Kontext freizugeben. Der sichtbare Chat bleibt unverändert. Ein eigenes Modell wählst du unter Einstellungen → Konversation → Erweitert → Kompaktierungsmodell."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 채팅 모델로 이전 메시지를 요약하여 컨텍스트를 확보합니다. 표시되는 채팅은 변경되지 않습니다. 설정 → 대화 → 고급 → 압축 모델에서 전용 모델을 선택하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резюмирует старые сообщения текущей моделью чата, чтобы освободить контекст. Видимый чат не меняется. Отдельную модель можно выбрать в Настройки → Беседа → Дополнительно → Модель сжатия."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用当前聊天模型总结较早的消息以释放上下文。可见的聊天内容不变。可在“设置 → 对话 → 高级 → 压缩模型”中选择专用模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用目前聊天模型總結較早的訊息以釋放上下文。可見的聊天內容不變。可在「設定 → 對話 → 高級 → 壓縮模型」中選擇專用模型。"
          }
        }
      }
    },
