          "stringUnit": {
            "state": "translated",
            "value": "\u6311\u9009\u4e00\u4e2a\u8d77\u70b9\uff0c\u7136\u540e\u6253\u9020\u4f60\u7684\u4e13\u5c5e\u3002\u5f53\u4f60\u9009\u62e9\u5934\u50cf\u3001\u540d\u79f0\u548c\u89d2\u8272\u65f6\uff0c\u9884\u89c8\u4f1a\u968f\u4e4b\u66f4\u65b0\u3002"
          }
        }
      }
    },
    "Pick a table to see its rows.": {
