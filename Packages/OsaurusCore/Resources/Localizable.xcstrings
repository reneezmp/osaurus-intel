    "%@ didn't allow this. Your account may not have access, or you may need to sign in again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat dies nicht erlaubt. Ihr Konto hat möglicherweise keinen Zugriff, oder Sie müssen sich erneut anmelden."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 이 작업을 허용하지 않았습니다. 계정에 접근 권한이 없거나 다시 로그인해야 할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не разрешил это действие. Возможно, у вашей учётной записи нет доступа или нужно войти снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不允许此操作。您的账户可能没有访问权限，或者需要重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不允許此操作。您的帳戶可能沒有存取權限，或者需要重新登入。"
          }
        }
      }
    },
    "%@ didn't answer at this address. The service may have moved; check the URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat unter dieser Adresse nicht geantwortet. Der Dienst ist möglicherweise umgezogen; prüfen Sie die URL."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이 주소에서 응답하지 않았습니다. 서비스가 이전되었을 수 있으니 URL을 확인하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не ответил по этому адресу. Возможно, сервис переехал — проверьте URL."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未在此地址响应。服务可能已迁移，请检查 URL。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未在此位址回應。服務可能已遷移，請檢查 URL。"
          }
        }
      }
    },
    "%@ has used %lld%% of its database storage (%.1f / %.1f MB)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat %lld %% seines Datenbankspeichers belegt (%.1f / %.1f MB)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已使用其数据库存储的 %lld%%（%.1f / %.1f MB）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 데이터베이스 저장 공간의 %lld%%를 사용했습니다(%.1f / %.1f MB)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ использует %lld%% хранилища базы данных (%.1f / %.1f МБ)."
          }
        }
      }
    },
    "%@ is having problems right now. Try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat gerade Probleme. Versuchen Sie es später erneut."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 현재 문제가 있습니다. 나중에 다시 시도하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@ сейчас неполадки. Повторите попытку позже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 目前出现问题，请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 目前發生問題，請稍後再試。"
          }
        }
      }
    },
    "%@ is not readable as UTF-8 text." : {
      "comment" : "Write failure when the existing config.toml is not UTF-8. %@ is the file path.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann nicht als UTF-8-Text gelesen werden."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) UTF-8 텍스트로 읽을 수 없습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не читается как текст в кодировке UTF-8."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法作为 UTF-8 文本读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法作為 UTF-8 文字讀取。"
          }
        }
      }
    },
    "%@ must be a finite number." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ muss eine endliche Zahl sein."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 必须是有限的数字。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 유한한 숫자여야 해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ должно быть конечным числом."
          }
        }
      }
    },
    "%@ must be an integer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ muss eine ganze Zahl sein."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 必须是整数。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 정수여야 해요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ должно быть целым числом."
          }
        }
      }
    },
    "%@ needs more information" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
