    "Detailed request logs are kept only for a short duration to save storage, so there's nothing to show for this response." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Detailed request logs are kept only for a short duration to save storage, so there's nothing to show for this response."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상세한 요청 로그는 저장 공간을 절약하기 위해 짧은 기간 동안만 보관되므로 이 응답에 대해 표시할 내용이 없습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подробные журналы запросов хранятся только в течение короткого периода времени для экономии места, поэтому для этого ответа нечего показывать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "详细的请求日志仅保留较短时间以节省存储空间，因此此响应没有可显示的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細的請求日誌僅保留較短時間以節省存儲空間，因此此響應沒有可顯示的內容。"
          }
        }
      }
    },
