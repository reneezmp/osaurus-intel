          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76d1\u89c6\u6587\u4ef6\u5939\u4e2d\u7684\u65b0\u6587\u4ef6\u2014\u2014\u6bcf\u5f53\u6709\u5185\u5bb9\u53d8\u5316\u65f6\uff0c\u667a\u80fd\u4f53\u90fd\u4f1a\u81ea\u52a8\u8fd0\u884c\u3002"
          }
        }
      }
    },
    "Watched Folder": {
