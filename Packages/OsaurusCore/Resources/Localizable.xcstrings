    },
    "Picks up quiet speech, waits longer for pauses": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt leises Sprechen, wartet l\u00e4nger auf Pausen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a5\u53d7\u5b89\u9759\u7684\u8bb2\u8bdd\uff0c\u7b49\u5f85\u66f4\u957f\u65f6\u95f4\u7684\u505c\u987f"
          }
        }
      }
    },
    "Pin a saved view from the Views tab to make it appear here. Use this Home tab as the agent's at-a-glance dashboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hefte eine gespeicherte Ansicht aus dem Tab \u201eAnsichten\u201c an, damit sie hier erscheint. Verwende diesen Tab \u201eStart\u201c als Dashboard mit dem \u00dcberblick \u00fcber den Agenten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u201c\u89c6\u56fe\u201d\u6807\u7b7e\u9875\u7f6e\u9876\u4e00\u4e2a\u5df2\u4fdd\u5b58\u7684\u89c6\u56fe\uff0c\u4f7f\u5176\u663e\u793a\u5728\u6b64\u5904\u3002\u53ef\u5c06\u6b64\u201c\u4e3b\u9875\u201d\u6807\u7b7e\u9875\u7528\u4f5c\u667a\u80fd\u4f53\u7684\u4e00\u89c8\u5f0f\u4eea\u8868\u677f\u3002"
          }
        }
      }
    },
