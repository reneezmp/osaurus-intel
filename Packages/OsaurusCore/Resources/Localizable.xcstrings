          }
        }
      }
    },
    "Pre-upgrade pairing \u2014 grants access to all agents and never expires. Revoke and re-pair to scope it to a single agent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopplung vor dem Upgrade \u2013 gew\u00e4hrt Zugriff auf alle Agenten und l\u00e4uft nie ab. Widerrufe und koppele erneut, um sie auf einen einzelnen Agenten zu beschr\u00e4nken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5347\u7ea7\u524d\u7684\u914d\u5bf9\u2014\u2014\u6388\u4e88\u5bf9\u6240\u6709\u667a\u80fd\u4f53\u7684\u8bbf\u95ee\u6743\u9650\u4e14\u6c38\u4e0d\u8fc7\u671f\u3002\u64a4\u9500\u5e76\u91cd\u65b0\u914d\u5bf9\u53ef\u5c06\u5176\u9650\u5b9a\u5230\u5355\u4e2a\u667a\u80fd\u4f53\u3002"
