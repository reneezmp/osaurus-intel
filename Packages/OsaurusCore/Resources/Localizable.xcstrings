    "GitHub connected" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub verbunden"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
