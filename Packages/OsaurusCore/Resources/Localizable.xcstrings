    "Keep the model's reasoning open while it is thinking, then collapse it once the answer begins. Useful for watching long agent tasks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält die Überlegungen des Modells geöffnet, während es nachdenkt, und klappt sie zu, sobald die Antwort beginnt. Praktisch, um lange Agentenaufgaben zu verfolgen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델이 생각하는 동안 추론을 펼쳐 두었다가 답변이 시작되면 접습니다. 긴 에이전트 작업을 지켜볼 때 유용합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держать рассуждения модели открытыми, пока она думает, и сворачивать их, когда начинается ответ. Удобно для наблюдения за долгими задачами агента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型思考时保持推理过程展开，回答开始后自动折叠。便于观察较长的智能体任务。"
          }
        }
      }
    },
