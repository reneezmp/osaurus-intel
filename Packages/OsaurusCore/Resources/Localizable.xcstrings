          }
        }
      }
    },
    "privacy.install.subtitle.failed": {
      "comment": "Subtitle of the install hero after a download/verification failure. The hero shows a separate inline detail line; this string is the call-to-action paired with the Retry button.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf \u201eWiederholen\u201c, um den Download erneut zu versuchen."
