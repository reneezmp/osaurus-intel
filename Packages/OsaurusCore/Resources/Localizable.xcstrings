        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bbf\u95ee\u5bc6\u94a5\u7684\u5143\u6570\u636e\u6309\u9700\u52a0\u8f7d\uff0c\u56e0\u6b64\u542f\u52a8\u65f6\u7edd\u4e0d\u4f1a\u8bfb\u53d6\u94a5\u5319\u4e32\u3002\u5237\u65b0\u4ee5\u67e5\u770b\u73b0\u6709\u5bc6\u94a5\u3002"
