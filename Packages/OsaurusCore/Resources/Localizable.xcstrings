        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91cd\u65b0\u542f\u52a8\u6c99\u76d2\u4ee5\u5e94\u7528\u6309\u667a\u80fd\u4f53\u7684\u6865\u63a5\u4ee4\u724c\u3002\u5728\u8fd0\u884c\u4e2d\u7684\u5bb9\u5668\u91c7\u7528\u65b0\u7684 shim \u4e4b\u524d\uff0c\u63d2\u4ef6\u8c03\u7528\u5c06\u8fd4\u56de 401\u3002"
