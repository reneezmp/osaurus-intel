      }
    },
    "Send anonymous crash and freeze reports so we can fix what breaks. Never includes your chats, prompts, files, or keys. Turn off any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende anonyme Absturz- und H\u00e4ngeberichte, damit wir Fehler beheben k\u00f6nnen. Niemals enthalten sind deine Chats, Prompts, Dateien oder Schl\u00fcssel. Jederzeit abschaltbar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53d1\u9001\u533f\u540d\u5d29\u6e83\u548c\u5361\u6b7b\u62a5\u544a\uff0c\u4ee5\u4fbf\u6211\u4eec\u4fee\u590d\u95ee\u9898\u3002\u7edd\u4e0d\u5305\u542b\u4f60\u7684\u804a\u5929\u3001\u63d0\u793a\u8bcd\u3001\u6587\u4ef6\u6216\u5bc6\u94a5\u3002\u53ef\u968f\u65f6\u5173\u95ed\u3002"
          }
        }
      }
    },
    "Send anonymous, aggregated usage analytics to help improve Osaurus. Never includes your chats, prompts, files, or keys. Turn off any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende anonyme, aggregierte Nutzungsanalysen, um Osaurus zu verbessern. Niemals enthalten sind deine Chats, Prompts, Dateien oder Schl\u00fcssel. Jederzeit abschaltbar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53d1\u9001\u533f\u540d\u3001\u6c47\u603b\u7684\u4f7f\u7528\u5206\u6790\uff0c\u4ee5\u5e2e\u52a9\u6539\u8fdb Osaurus\u3002\u7edd\u4e0d\u5305\u542b\u4f60\u7684\u804a\u5929\u3001\u63d0\u793a\u8bcd\u3001\u6587\u4ef6\u6216\u5bc6\u94a5\u3002\u53ef\u968f\u65f6\u5173\u95ed\u3002"
          }
        }
      }
    },
    "Send crash reports": {
      "localizations": {
