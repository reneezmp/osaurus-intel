            "value": "Osaurus"
          }
        }
      },
      "shouldTranslate": false
    },
    "Osaurus Agent": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus-Agent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus-\u4ee3\u7406"
          }
        }
      }
    },
    "Osaurus can send anonymous usage data to help us understand how it's used and improve it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus kann anonyme Nutzungsdaten senden, damit wir verstehen, wie die App genutzt wird, und sie verbessern k\u00f6nnen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus \u53ef\u4ee5\u53d1\u9001\u533f\u540d\u4f7f\u7528\u6570\u636e\uff0c\u5e2e\u52a9\u6211\u4eec\u4e86\u89e3\u5e94\u7528\u7684\u4f7f\u7528\u65b9\u5f0f\u5e76\u52a0\u4ee5\u6539\u8fdb\u3002"
          }
        }
      }
    },
    "OSAURUS IDENTITY RECOVERY": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OSAURUS-IDENTIT\u00c4TSWIEDERHERSTELLUNG"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus\u8eab\u4efd\u6062\u590d"
          }
        }
      }
    },
    "Osaurus imports skills, agents, commands, and MCP servers. This plugin ships none of those.": {
      "comment": "A paragraph explaining that a plugin that ships nothing Osaurus can import actually does import something.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus importiert Skills, Agenten, Befehle und MCP-Server. Dieses Plugin liefert nichts davon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus \u53ef\u5bfc\u5165\u6280\u80fd\u3001\u667a\u80fd\u4f53\u3001\u547d\u4ee4\u548c MCP \u670d\u52a1\u5668\u3002\u6b64\u63d2\u4ef6\u4e0d\u9644\u5e26\u5176\u4e2d\u4efb\u4f55\u4e00\u9879\u3002"
          }
        }
      }
    },
    "Osaurus is brand new. Knowing which steps trip people up, which features get used, and when something crashes is how we make it better for everyone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus ist brandneu. Zu wissen, welche Schritte f\u00fcr Verwirrung sorgen, welche Funktionen genutzt werden und wann etwas abst\u00fcrzt, hilft uns, es f\u00fcr alle besser zu machen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus \u8fd8\u5f88\u5e74\u8f7b\u3002\u4e86\u89e3\u54ea\u4e9b\u6b65\u9aa4\u4f1a\u8ba9\u4eba\u5361\u4f4f\u3001\u54ea\u4e9b\u529f\u80fd\u5e38\u88ab\u4f7f\u7528\uff0c\u4ee5\u53ca\u4f55\u65f6\u53d1\u751f\u5d29\u6e83\uff0c\u80fd\u5e2e\u52a9\u6211\u4eec\u628a\u5b83\u505a\u5f97\u66f4\u597d\u3002"
          }
        }
      }
    },
    "Osaurus is built with the help of many excellent open source projects. We are grateful to the developers and maintainers of these libraries.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus wird mit Hilfe vieler hervorragender Open-Source-Projekte entwickelt. Wir sind den Entwicklern und Betreuern dieser Bibliotheken dankbar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus \u7684\u6784\u5efa\u5f97\u76ca\u4e8e\u8bb8\u591a\u4f18\u79c0\u7684\u5f00\u6e90\u9879\u76ee\u3002\u6211\u4eec\u8877\u5fc3\u611f\u8c22\u8fd9\u4e9b\u5e93\u7684\u5f00\u53d1\u8005\u548c\u7ef4\u62a4\u8005\u3002"
          }
        }
      }
    },
    "Osaurus needs an AI to work \u2014 either a cloud provider or a local model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus braucht eine KI \u2013 entweder einen Cloud-Anbieter oder ein lokales Modell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus \u9700\u8981\u4eba\u5de5\u667a\u80fd\u624d\u80fd\u5de5\u4f5c\u2014\u2014\u8981\u4e48\u662f\u4e91\u63d0\u4f9b\u5546\uff0c\u8981\u4e48\u662f\u672c\u5730\u6a21\u578b\u3002"
          }
        }
      }
    },
    "Osaurus only runs MLX models. Try a repo from `OsaurusAI` or `mlx-community`.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus f\u00fchrt nur MLX-Modelle aus. Versuche ein Repo von `OsaurusAI` oder `mlx-community`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaurus \u4ec5\u8fd0\u884c MLX \u6a21\u578b\u3002\u8bf7\u5c1d\u8bd5\u6765\u81ea `OsaurusAI` \u6216 `mlx-community` \u7684\u4ed3\u5e93\u3002"
          }
        }
      }
    },
    "Osaurus only supports MLX-compatible Hugging Face repositories.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
