        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8be5\u6a21\u5f0f\u4f1a\u5339\u914d\u7a7a\u5b57\u7b26\u4e32\u3002\u8bf7\u6536\u7d27\u5b83\uff0c\u4f7f\u5176\u81f3\u5c11\u8981\u6c42\u4e00\u4e2a\u5b57\u7b26\u3002"
          }
        }
      }
    },
