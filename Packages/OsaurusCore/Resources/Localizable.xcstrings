          "stringUnit": {
            "state": "translated",
            "value": "\u89e3\u5bc6 `~/.osaurus` \u76ee\u5f55\u4e0b\u7684\u6240\u6709\u6587\u4ef6\uff0c\u5e76\u5c06\u660e\u6587\u526f\u672c\u5199\u5165\u60a8\u9009\u62e9\u7684\u76ee\u6807\u4f4d\u7f6e\u3002\u5efa\u8bae\u5728\u91cd\u65b0\u5b89\u88c5 macOS \u6216\u8fc1\u79fb Mac \u4e4b\u524d\u6267\u884c\u6b64\u64cd\u4f5c\u3002"
