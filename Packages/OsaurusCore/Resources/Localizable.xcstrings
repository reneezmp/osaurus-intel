          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 将使用该文件夹作为其工作目录。"
          }
        }
      }
    },
    "The bundle has the required local files. Runtime quality still depends on model-family support and live generation proof." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Bundle enthält die erforderlichen lokalen Dateien. Die Laufzeitqualität hängt weiterhin von der Modellfamilienunterstützung und dem Live-Generierungsnachweis ab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "捆绑包包含所需的本地文件。运行时质量仍取决于模型系列支持和实时生成证明。"
          }
        }
      }
    },
    "The chat is still running a command — revert is paused until it finishes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Chat führt noch einen Befehl aus – Zurücksetzen ist pausiert, bis er fertig ist."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화가 아직 명령을 실행 중입니다. 완료될 때까지 되돌리기가 일시 중지됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чат ещё выполняет команду — откат приостановлен до её завершения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聊天仍在运行命令 — 还原已暂停，直到命令完成。"
          }
        }
      }
    },
    "The container's /workspace directory is bind-mounted from ~/.osaurus/container/workspace/. Open it in Finder to browse or edit files directly on the host." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das /workspace-Verzeichnis des Containers wird per Bind-Mount aus ~/.osaurus/container/workspace/ eingebunden. Öffne es im Finder, um Dateien direkt auf dem Host zu durchsuchen oder zu bearbeiten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容器的 /workspace 目录通过绑定挂载方式来自 ~/.osaurus/container/workspace/。在访达中打开它，可直接在主机上浏览或编辑文件。"
          }
        }
      }
    },
    "The current model is text-only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das aktuelle Modell ist nur für Text."
          }
        },
        "en" : {
