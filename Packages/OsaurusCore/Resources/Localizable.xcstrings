          }
        }
      }
    },
    "All buffered turns have been distilled (or purged). The pipeline is healthy when episodes are growing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "All buffered turns have been distilled (or purged). The pipeline is healthy when episodes are growing."
