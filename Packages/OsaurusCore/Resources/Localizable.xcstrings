        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6240\u6709\u7f13\u51b2\u7684\u5bf9\u8bdd\u8f6e\u6b21\u5747\u5df2\u63d0\u70bc\uff08\u6216\u6e05\u9664\uff09\u3002\u5f53\u6570\u636e\u7247\u6bb5\u6301\u7eed\u589e\u957f\u65f6\uff0c\u8868\u660e\u7ba1\u9053\u8fd0\u884c\u6b63\u5e38\u3002"
