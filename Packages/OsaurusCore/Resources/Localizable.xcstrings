          }
        }
      }
    },
    "Pick when this agent should resume firing scheduled and self-scheduled runs. The optional reason is logged in the audit trail.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hle, wann dieser Agent geplante und selbst geplante L\u00e4ufe wieder ausl\u00f6sen soll. Der optionale Grund wird im Audit-Protokoll festgehalten."
          }
