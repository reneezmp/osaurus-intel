            "value": "\u9009\u62e9\u6b64\u667a\u80fd\u4f53\u53ef\u4ee5\u4f7f\u7528\u7684\u5de5\u5177\u548c\u6280\u80fd"
          }
        }
      }
    },
    "Pick which tools and skills this agent can use.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pick which tools and skills this agent can use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
