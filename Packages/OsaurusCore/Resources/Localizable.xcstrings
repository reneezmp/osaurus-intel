            "state": "translated",
            "value": "\u68c0\u6d4b\u5728\u672c\u5730\u8fd0\u884c\uff0c\u4e14\u6346\u7ed1\u5305\u5df2\u901a\u8fc7\u9a8c\u8bc1\u3002"
