      }
    },
    "Allowed Origins (CORS)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allowed Origins (CORS)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u7684\u6765\u6e90\uff08CORS\uff09"
          }
        }
      }
    },
    "Allows capturing system audio for transcription. Screen content is not recorded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt das Aufnehmen von System-Audio f\u00fcr Transkription. Bildschirminhalte werden nicht aufgezeichnet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u6355\u83b7\u7cfb\u7edf\u97f3\u9891\u8fdb\u884c\u8f6c\u5f55\u3002\u4e0d\u8bb0\u5f55\u5c4f\u5e55\u5185\u5bb9\u3002"
          }
        }
      }
    },
    "Allows plugins to access and search contacts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Plugins, auf Kontakte zuzugreifen und sie zu durchsuchen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u63d2\u4ef6\u8bbf\u95ee\u548c\u641c\u7d22\u8054\u7cfb\u4eba\u3002"
          }
        }
      }
    },
    "Allows plugins to access protected files like the Messages database and other app data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Plugins, auf gesch\u00fctzte Dateien wie die Nachrichten-Datenbank und andere App-Daten zuzugreifen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u63d2\u4ef6\u8bbf\u95ee\u53d7\u4fdd\u62a4\u7684\u6587\u4ef6\uff0c\u4f8b\u5982\u6d88\u606f\u6570\u636e\u5e93\u548c\u5176\u4ed6\u5e94\u7528\u7a0b\u5e8f\u6570\u636e\u3002"
          }
        }
      }
    },
    "Allows plugins to access your calendar to read and create events directly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Plugins, direkt auf deinen Kalender zuzugreifen, um Termine zu lesen und zu erstellen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u63d2\u4ef6\u8bbf\u95ee\u60a8\u7684\u65e5\u5386\u4ee5\u76f4\u63a5\u8bfb\u53d6\u548c\u521b\u5efa\u4e8b\u4ef6\u3002"
          }
        }
      }
    },
    "Allows plugins to access your current location.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Plugins, auf deinen aktuellen Standort zuzugreifen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u63d2\u4ef6\u8bbf\u95ee\u60a8\u5f53\u524d\u7684\u4f4d\u7f6e\u3002"
          }
        }
      }
    },
    "Allows plugins to access your reminders to read and create tasks.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Plugins, auf deine Erinnerungen zuzugreifen, um Aufgaben zu lesen und zu erstellen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u63d2\u4ef6\u8bbf\u95ee\u60a8\u7684\u63d0\u9192\u4ee5\u9605\u8bfb\u548c\u521b\u5efa\u4efb\u52a1\u3002"
          }
        }
      }
    },
    "Allows plugins to control Maps app via AppleScript.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Plugins, die Karten-App via AppleScript zu steuern."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u63d2\u4ef6\u901a\u8fc7 AppleScript \u63a7\u5236\u5730\u56fe\u5e94\u7528\u7a0b\u5e8f\u3002"
          }
        }
      }
    },
    "Allows plugins to control other applications using AppleScript and Apple Events.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt Plugins, andere Apps via AppleScript und Apple Events zu steuern."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u63d2\u4ef6\u4f7f\u7528 AppleScript \u548c Apple Events \u63a7\u5236\u5176\u4ed6\u5e94\u7528\u7a0b\u5e8f\u3002"
          }
        }
      }
    },
    "Allows plugins to interact with UI elements, simulate input, and control the computer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
