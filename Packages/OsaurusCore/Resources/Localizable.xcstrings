    "OSAURUS IDENTITY RECOVERY" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OSAURUS-IDENTITÄTSWIEDERHERSTELLUNG"
