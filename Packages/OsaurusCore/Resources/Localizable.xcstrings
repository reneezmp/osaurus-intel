    },
    "Its address is already used by “%@”, so it arrives without one. Assign a new address in Identity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Adresse wird bereits von „%@“ verwendet, daher kommt er ohne Adresse an. Weise ihm unter „Identität“ eine neue zu."
