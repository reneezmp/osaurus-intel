    "Expose this agent to the public internet via a relay tunnel so external services can reach it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mache diesen Agenten über einen Relay-Tunnel im öffentlichen Internet erreichbar, damit externe Dienste auf ihn zugreifen können."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외부 서비스가 접근할 수 있도록 릴레이 터널을 통해 이 에이전트를 공용 인터넷에 노출합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предоставьте этому агенту доступ к общедоступному Интернету через ретрансляционный туннель, чтобы внешние службы могли получить к нему доступ."
          }
        },
