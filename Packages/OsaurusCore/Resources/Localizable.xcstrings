    "Send messages directly to the model with no tool specs or capability injection. Turn off to let agents use built-in and plugin tools." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet Nachrichten direkt an das Modell, ohne Tool-Beschreibungen oder Fähigkeiten. Schalte es aus, damit Agenten eingebaute und Plugin-Tools nutzen können."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구 사양이나 기능 주입 없이 모델에 직접 메시지를 보냅니다. 끄면 에이전트가 내장 및 플러그인 도구를 사용할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлять сообщения модели напрямую, без описаний инструментов и внедрения возможностей. Выключите, чтобы агенты могли использовать встроенные инструменты и инструменты плагинов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接将消息发送给模型，不附带工具说明或能力注入。关闭后，智能体即可使用内置工具和插件工具。"
          }
        }
      }
    },
