    "On open the chain head (seq %@) disagreed with the database tail (seq %@); the log continues from the database." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Öffnen stimmte der Kettenkopf (Seq. %@) nicht mit dem Datenbankende (Seq. %@) überein; das Protokoll wird ab der Datenbank fortgesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On open the chain head (seq %1$@) disagreed with the database tail (seq %2$@); the log continues from the database."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열 때 체인 헤드(순번 %@)가 데이터베이스 끝(순번 %@)과 일치하지 않았습니다. 로그는 데이터베이스에서 이어집니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При открытии заголовок цепочки (номер %@) не совпал с концом базы данных (номер %@); журнал продолжается по базе данных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开时链头（序号 %@）与数据库末尾（序号 %@）不一致；日志将从数据库继续。"
          }
        }
      }
    },
