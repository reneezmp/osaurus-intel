          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "What do these filters mean?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u4e9b\u7b5b\u9009\u5668\u662f\u4ec0\u4e48\u610f\u601d\uff1f"
          }
        }
      }
    },
    "What should the AI do when changes are detected?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was soll die KI tun, wenn \u00c4nderungen erkannt werden?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u68c0\u6d4b\u5230\u66f4\u6539\u65f6\uff0cAI \u5e94\u8be5\u505a\u4ec0\u4e48\uff1f"
          }
        }
      }
    },
    "What should the AI do when this runs?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was soll die KI tun, wenn dies ausgef\u00fchrt wird?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f53\u8fd9\u4e2a\u8fd0\u884c\u65f6\uff0cAI \u5e94\u8be5\u505a\u4ec0\u4e48\uff1f"
          }
        }
      }
    },
    "What the model can draw on by default.": {
      "comment": "Subtitle for the \"Model Access\" feature group in the Agent Detail View.",
      "isCommentAutoGenerated": true,
      "localizations": {
