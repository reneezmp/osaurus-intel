        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7559\u7a7a\u4ee5\u4f7f\u7528\u5168\u5c40\u8bbe\u7f6e\u4e2d\u7684\u9ed8\u8ba4\u503c\u3002"
          }
        }
      }
    },
    "Leave the key blank if your local Ollama doesn't require one.": {
      "comment": "Hint text for the \"Key\" field in the \"Ollama\" provider credential instructions, indicating that a key is not required.",
      "isCommentAutoGenerated": true,
