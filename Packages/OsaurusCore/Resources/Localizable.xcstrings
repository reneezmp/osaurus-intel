        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Retry to attempt the download again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70b9\u51fb\u201c\u91cd\u8bd5\u201d\u4ee5\u518d\u6b21\u5c1d\u8bd5\u4e0b\u8f7d\u3002"
          }
        }
      }
    },
    "privacy.install.subtitle.ready": {
      "comment": "Subtitle of the install hero in the post-install ready state. Mirrors the success message users see briefly before the tabs take over.",
      "localizations": {
