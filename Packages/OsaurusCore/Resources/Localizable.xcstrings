    "It was moved or deleted, so it was removed from Recent Folders." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wurde verschoben oder gelöscht und daher aus den zuletzt verwendeten Ordnern entfernt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동되었거나 삭제되어 최근 폴더에서 제거되었습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
