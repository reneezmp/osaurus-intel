    "Editing the wake-up brief flags the row as user-scheduled so the agent knows you intervened." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bearbeiten des Weck-Briefings markiert die Zeile als benutzergeplant, damit der Agent weiß, dass du eingegriffen hast."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "깨우기 브리핑을 편집하면 행이 사용자가 예약한 것으로 플래그가 지정되어 에이전트가 귀하의 개입을 알 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При редактировании запроса на пробуждение эта строка помечается как запланированная пользователем, чтобы агент знал, что вы вмешались."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑唤醒简报会将该行标记为用户计划，以便智能体知道你进行了干预。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編輯喚醒簡報會將該行標記爲用戶計劃，以便智能體知道你進行了幹預。"
          }
        }
      }
    },
