    "Summarize older messages to free up context" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ältere Nachrichten zusammenfassen, um Kontext freizugeben"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总结较早的消息以释放上下文"
          }
        }
      }
    },
    "Summarizes older messages with the current chat model to free up context (one cloud request). The visible chat is unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasst ältere Nachrichten mit dem aktuellen Chat-Modell zusammen, um Kontext freizugeben (eine Cloud-Anfrage). Der sichtbare Chat bleibt unverändert."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用当前聊天模型总结较早的消息以释放上下文（一次云端请求）。可见的聊天内容保持不变。"
          }
        }
      }
    },
    "Summarizes the older part of this chat with the current model (one cloud request). The full chat stays visible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasst den älteren Teil dieses Chats mit dem aktuellen Modell zusammen (eine Cloud-Anfrage). Der ganze Chat bleibt sichtbar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用当前模型总结此聊天中较早的部分（一次云端请求）。完整聊天仍然可见。"
          }
        }
      }
    },
    "Summarizing older messages…" : {
