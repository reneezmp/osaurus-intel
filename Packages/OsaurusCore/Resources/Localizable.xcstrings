    },
    "Its address is already used by “%@”, so it arrives without one. Assign a new address in Identity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Adresse wird bereits von „%@“ verwendet, daher kommt er ohne Adresse an. Weise ihm unter „Identität“ eine neue zu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소가 이미 “%@”에서 사용 중이라 주소 없이 도착합니다. ID에서 새 주소를 지정하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его адрес уже занят «%@», поэтому он прибывает без адреса. Назначьте новый адрес в разделе «Идентичность»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
