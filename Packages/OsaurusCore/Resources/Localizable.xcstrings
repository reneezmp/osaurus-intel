        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bfc\u5165\u7684 stdio MCP \u670d\u52a1\u5668\u8fd0\u884c\u5728 Osaurus \u6c99\u76d2\u5185\uff0c\u800c\u672c\u673a\u4e0d\u63d0\u4f9b\u8be5\u6c99\u76d2\u3002\u4ee5\u4e0b\u670d\u52a1\u5668\u672a\u88ab\u5b89\u88c5\uff1a"
          }
        }
      }
