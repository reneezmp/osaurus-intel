          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u8df3\u8fc7\u6240\u6709\u8131\u654f\u2014\u2014\u4f60\u7684\u6d88\u606f\u5c06\u6309\u539f\u6837\u53d1\u9001\u3002"
          }
        }
      }
    },
    "privacy.review.subtitle": {
      "comment": "A subtitle explaining the purpose of the privacy review sheet.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Elemente werden durch Platzhalter ersetzt, bevor deine Nachricht deinen Mac verl\u00e4sst. Deaktiviere alles, was du lieber unver\u00e4ndert senden m\u00f6chtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These items will be replaced with placeholders before your message leaves your Mac. Toggle off anything you'd rather send as-is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4f60\u7684\u6d88\u606f\u79bb\u5f00 Mac \u4e4b\u524d\uff0c\u8fd9\u4e9b\u9879\u76ee\u5c06\u88ab\u66ff\u6362\u4e3a\u5360\u4f4d\u7b26\u3002\u5173\u95ed\u4efb\u4f55\u4f60\u5e0c\u671b\u6309\u539f\u6837\u53d1\u9001\u7684\u5185\u5bb9\u3002"
          }
        }
      }
    },
