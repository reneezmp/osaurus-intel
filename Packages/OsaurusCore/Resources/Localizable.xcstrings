    "Manual mode never auto-distills. Use 'Distill pending' or set to sessionEnd." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Manual mode never auto-distills. Use 'Distill pending' or set to sessionEnd."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수동 모드에서는 자동 압축이 실행되지 않습니다. '대기 중인 항목 압축'을 사용하거나 sessionEnd로 설정하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ручной режим никогда не выполняет автоматическую дистилляцию. Используйте «Ожидание дистилляции» или установите значение sessionEnd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动模式绝不会自动蒸馏。请使用“蒸馏待处理项”，或设置为会话结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動模式永遠不會自動蒸餾。請使用「待蒸餾」或設置爲會話結束。"
          }
        }
      }
    },
