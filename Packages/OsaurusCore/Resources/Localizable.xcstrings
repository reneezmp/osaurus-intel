        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6c99\u76d2\u5bb9\u5668\u5185\u8fd0\u884c\u7684\u5185\u7f6e\u6c99\u76d2\u6267\u884c\u5de5\u5177\u548cJSON\u5b9a\u4e49\u7684\u63d2\u4ef6\u5de5\u5177\u3002"
          }
        }
      }
    },
