    "Files larger than 100 MB are not supported. Trim before attaching." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien größer als 100 MB werden nicht unterstützt. Vor dem Anhängen kürzen."
          }
        },
