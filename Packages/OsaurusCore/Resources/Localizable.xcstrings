        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки → Управление данными → Экспорт данных аккаунта. Ссылка для скачивания придёт по электронной почте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 → 数据控制 → 导出账户数据。下载链接将通过电子邮件发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
