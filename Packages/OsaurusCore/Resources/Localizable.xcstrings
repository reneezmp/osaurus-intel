          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u5bb9\u5668\u7684\u51fa\u7ad9\u7f51\u7edc\u8fde\u63a5"
          }
        }
      }
    },
    "Allow outbound network from the sandbox. Turn off to cut data exfiltration (takes effect on next sandbox start).": {
      "comment": "A description of the \"Sandbox Network\" toggle in the Agent Detail View.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgehenden Netzwerkverkehr aus der Sandbox zulassen. Deaktivieren, um Datenabfluss zu unterbinden (wird beim n\u00e4chsten Sandbox-Start wirksam)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u6c99\u76d2\u53d1\u8d77\u51fa\u7ad9\u7f51\u7edc\u8fde\u63a5\u3002\u5173\u95ed\u53ef\u963b\u6b62\u6570\u636e\u5916\u6cc4\uff08\u5c06\u5728\u4e0b\u6b21\u542f\u52a8\u6c99\u76d2\u65f6\u751f\u6548\uff09\u3002"
          }
        }
      }
    },
    "Allow prompts up to (window \u00d7 multiplier) before the cap kicks in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Allow prompts up to (window \u00d7 multiplier) before the cap kicks in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u9650\u5236\u751f\u6548\u524d\uff0c\u5141\u8bb8\u63d0\u793a\u957f\u5ea6\u8fbe\u5230\uff08\u7a97\u53e3 \u00d7 \u4e58\u6570\uff09\u3002"
          }
        }
      }
    },
    "Allow the agent to run arbitrary commands in the sandbox.": {
      "comment": "A feature toggle that lets the agent execute arbitrary commands in the sandbox.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube dem Agenten, beliebige Befehle in der Sandbox auszuf\u00fchren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u667a\u80fd\u4f53\u5728\u6c99\u76d2\u4e2d\u8fd0\u884c\u4efb\u610f\u547d\u4ee4\u3002"
          }
        }
      }
    },
    "Allow Video": {
      "comment": "Label for a toggle that lets the user enable or disable the ability to send video-bearing requests to the server.",
      "isCommentAutoGenerated": true,
