        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4f60\u7684 Mac \u4e0a\u8fd0\u884c\u3002\u4f60\u7684\u804a\u5929\u8bb0\u5f55\u3001\u6587\u4ef6\u548c\u5bc6\u94a5\u90fd\u7559\u5728\u4f60\u8fd9\u91cc\u3002\u65e0\u9700\u8d26\u6237\uff0c\u65e0\u9700\u4e91\u7aef\u3002"
