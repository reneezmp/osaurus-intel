        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "401 챌린지는 마지막 오류가 보존된 인라인 로그인 또는 토큰 프롬프트로 표시됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
