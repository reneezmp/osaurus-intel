    "E2E" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E2E"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端到端"
          }
        }
      }
    },
    "Each agent has its own tabs. Scheduled and background runs open here too, so you can switch between chats like browser tabs without interrupting responses in progress." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Agent hat seine eigenen Tabs. Geplante und Hintergrundläufe öffnen sich ebenfalls hier, sodass du wie zwischen Browser-Tabs zwischen Chats wechseln kannst, ohne laufende Antworten zu unterbrechen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트마다 고유한 탭이 있습니다. 예약 실행과 백그라운드 실행도 여기에 열리므로, 진행 중인 응답을 중단하지 않고 브라우저 탭처럼 채팅을 전환할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У каждого агента свои вкладки. Запланированные и фоновые запуски тоже открываются здесь, поэтому можно переключаться между чатами, как между вкладками браузера, не прерывая ответы, которые ещё формируются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个智能体都有自己的标签页。定时运行和后台运行也会在这里打开，因此你可以像浏览器标签页一样切换聊天，而不会打断正在生成的回复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個代理都有自己的分頁。排程執行和背景執行也會在這裡開啟，因此你可以像瀏覽器分頁一樣切換聊天，而不會打斷正在生成的回覆。"
          }
        }
      }
    },
    "Each one gets its own access, and you can take it back any time." : {
