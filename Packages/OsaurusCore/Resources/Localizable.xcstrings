    "%@ already defines model_providers.osaurus outside the Osaurus-managed block. Remove that definition (or move it between the markers) and try again." : {
      "comment" : "Write refusal when the user's config.toml has an unmanaged [model_providers.osaurus] table. %@ is the config.toml path.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ definiert model_providers.osaurus bereits außerhalb des von Osaurus verwalteten Blocks. Entferne diese Definition (oder verschiebe sie zwischen die Markierungen) und versuche es erneut."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 Osaurus 관리 블록 밖에서 model_providers.osaurus가 이미 정의되어 있습니다. 해당 정의를 제거하거나 마커 사이로 옮긴 뒤 다시 시도하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже определяет model_providers.osaurus вне блока, управляемого Osaurus. Удалите это определение (или перенесите его между маркерами) и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在 Osaurus 托管块之外定义了 model_providers.osaurus。请删除该定义（或将其移到标记之间）后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已在 Osaurus 管理區塊之外定義了 model_providers.osaurus。請移除該定義（或將其移到標記之間）後再試一次。"
          }
        }
      }
    },
    "%@ can't use these generation settings: %@. Clear them in the agent's Generation Overrides, or choose another model." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann diese Generierungseinstellungen nicht verwenden: %@. Entferne sie in den Generierungs-Überschreibungen des Agenten oder wähle ein anderes Modell."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法使用这些生成设置：%@。请在智能体的“生成覆盖”中清除它们，或选择其他模型。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서는 다음 생성 설정을 사용할 수 없어요: %@. 에이전트의 생성 재정의에서 지우거나 다른 모델을 선택하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не может использовать эти параметры генерации: %@. Сбросьте их в переопределениях генерации агента или выберите другую модель."
          }
        }
      }
    },
