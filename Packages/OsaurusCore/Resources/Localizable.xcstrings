    },
    "Up to 48 runs/day · as often as every 5 min · no quiet hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu 48 Läufe/Tag · bis zu alle 5 Min. · keine Ruhezeit."
          }
        },
        "zh-Hans" : {
