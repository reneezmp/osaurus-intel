          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以更改 Osaurus 设置"
          }
        }
      }
    },
    "Model used in the background for memory, chat titles and transcription cleanup. If unset, your active chat model is used." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modell, das im Hintergrund für Gedächtnis, Chat-Titel und die Bereinigung von Transkriptionen genutzt wird. Ohne Auswahl wird dein aktives Chat-Modell verwendet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리, 채팅 제목, 받아쓰기 정리를 위해 백그라운드에서 사용하는 모델입니다. 설정하지 않으면 활성 채팅 모델을 사용합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель, используемая в фоне для памяти, названий чатов и очистки транскрипции. Если не задана, используется активная модель чата."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台用于记忆、聊天标题和转录清理的模型。未设置时使用你当前的聊天模型。"
          }
        }
      }
    },
    "Music" : {
      "localizations" : {
