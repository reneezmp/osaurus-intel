        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9009\u62e9\u6b64\u667a\u80fd\u4f53\u4f55\u65f6\u5e94\u6062\u590d\u89e6\u53d1\u8ba1\u5212\u8fd0\u884c\u548c\u81ea\u6211\u8ba1\u5212\u8fd0\u884c\u3002\u53ef\u9009\u7684\u539f\u56e0\u4f1a\u8bb0\u5f55\u5728\u5ba1\u8ba1\u65e5\u5fd7\u4e2d\u3002"
          }
        }
      }
    },
