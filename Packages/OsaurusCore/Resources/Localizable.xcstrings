    "Premium search ran out of credits and is quietly using the built-in sources. Add credits to resume - nothing else to reset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Premium search ran out of credits and is quietly using the built-in sources. Add credits to resume - nothing else to reset."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Premium search ran out of credits and is quietly using the built-in sources. Add credits to resume - nothing else to reset."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Premium search ran out of credits and is quietly using the built-in sources. Add credits to resume - nothing else to reset."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高级搜索积分已用完，正在静默使用内置源。添加积分以恢复 — 无需其他重置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進階搜尋積分已用完，正在靜默使用內置源。新增積分以邊原 — 無需其他重設。"
          }
        }
      }
    },
    "Premium search runs the `web_search` tool through Osaurus - better results with zero setup. Search credits cover requests first; after that, requests bill this wallet. If credits run out, search continues on the built-in sources automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Premium search runs the `web_search` tool through Osaurus - better results with zero setup. Search credits cover requests first; after that, requests bill this wallet. If credits run out, search continues on the built-in sources automatically."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Premium search runs the `web_search` tool through Osaurus - better results with zero setup. Search credits cover requests first; after that, requests bill this wallet. If credits run out, search continues on the built-in sources automatically."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Premium search runs the `web_search` tool through Osaurus - better results with zero setup. Search credits cover requests first; after that, requests bill this wallet. If credits run out, search continues on the built-in sources automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高级搜索通过 Osaurus 运行 `web_search` 工具 — 零设置即可获得更好的结果。请求费用优先由搜索积分抵扣；积分用完后，请求将从此钱包计费。若积分耗尽，搜索会自动继续使用内置源。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進階搜尋通過 Osaurus 運行 `web_search` 工具 — 零設定即可獲得更好的結果。搜尋積分優先覆蓋請求；之後，請求從此錢包計費。積分用完後，搜尋自動切換到內置源。"
          }
        }
      }
    },
