      }
    },
    "This permanently removes this agent's chats, pinned facts, and episode summaries. The agent and its settings stay. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die Chats, angehefteten Fakten und Episodenzusammenfassungen dieses Agenten dauerhaft entfernt. Der Agent und seine Einstellungen bleiben erhalten. Das kann nicht rückgängig gemacht werden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
