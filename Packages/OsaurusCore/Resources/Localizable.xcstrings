          }
        }
      }
    },
    "All disabled by default. Enable individually \u2014 Osaurus will redact matches and block sends that leak them.": {
      "comment": "A longer description of the purpose of the \"Preset Rules\" section.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardm\u00e4\u00dfig alle deaktiviert. Einzeln aktivieren \u2013 Osaurus schw\u00e4rzt Treffer und blockiert Sendungen, die sie preisgeben."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ed8\u8ba4\u5168\u90e8\u7981\u7528\u3002\u53ef\u9010\u9879\u542f\u7528\u2014\u2014Osaurus \u4f1a\u5bf9\u5339\u914d\u9879\u8fdb\u884c\u8131\u654f\uff0c\u5e76\u963b\u6b62\u6cc4\u9732\u8fd9\u4e9b\u5185\u5bb9\u7684\u53d1\u9001\u3002"
          }
        }
      }
    },
    "All enabled capabilities are sent to the model every turn.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle aktivierten Funktionen werden bei jeder Runde an das Modell gesendet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u4e00\u8f6e\u90fd\u4f1a\u5c06\u6240\u6709\u5df2\u542f\u7528\u7684\u80fd\u529b\u53d1\u9001\u7ed9\u6a21\u578b\u3002"
          }
        }
      }
    },
    "All enabled items are sent every turn.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle aktivierten Elemente werden bei jeder Runde gesendet."
