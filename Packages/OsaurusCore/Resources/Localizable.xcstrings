    "Offer text you've just copied in any app as context, and grab the current selection when you summon Osaurus." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bietet Text, den du gerade in einer beliebigen App kopiert hast, als Kontext an und übernimmt die aktuelle Auswahl, wenn du Osaurus aufrufst."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 앱에서든 방금 복사한 텍스트를 컨텍스트로 제공하고, Osaurus를 호출할 때 현재 선택 항목을 가져옵니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предлагать только что скопированный в любом приложении текст как контекст и захватывать текущее выделение при вызове Osaurus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你刚在任意应用中复制的文本作为上下文提供，并在唤起 Osaurus 时获取当前选中内容。"
          }
        }
      }
    },
