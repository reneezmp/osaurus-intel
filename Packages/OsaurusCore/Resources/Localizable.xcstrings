    "Follow System Accent" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemakzentfarbe verwenden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow System Accent"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 강조 색상 따르기"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать системный акцент"
          }
        },
        "zh-Hans" : {
