          }
        }
      }
    },
    "Pace incoming tokens at a steady rate so streaming looks like a typewriter across all providers. Disable to render tokens as soon as they arrive \u2014 useful with very fast remote providers that you'd rather see complete instantly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pace incoming tokens at a steady rate so streaming looks like a typewriter across all providers. Disable to render tokens as soon as they arrive \u2014 useful with very fast remote providers that you'd rather see complete instantly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ba9\u4f20\u5165\u7684 token \u4ee5\u7a33\u5b9a\u7684\u901f\u7387\u9010\u5b57\u51fa\u73b0\uff0c\u8fd9\u6837\u65e0\u8bba\u54ea\u4e2a\u8fdc\u7a0b\u63d0\u4f9b\u5546\uff0c\u6d41\u5f0f\u8f93\u51fa\u90fd\u50cf\u6253\u5b57\u673a\u4e00\u6837\u8fde\u8d2f\u3002\u7981\u7528\u6b64\u529f\u80fd\u540e\uff0ctoken \u4f1a\u5728\u5230\u8fbe\u65f6\u7acb\u5373\u6e32\u67d3 \u2014 \u8fd9\u5bf9\u4e8e\u60a8\u5e0c\u671b\u7acb\u5373\u5b8c\u6210\u7684\u975e\u5e38\u5feb\u901f\u7684\u8fdc\u7a0b\u63d0\u4f9b\u8005\u5f88\u6709\u7528\u3002"
          }
        }
      }
    },
