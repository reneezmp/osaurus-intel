    "Encrypted, but the storage key is unavailable on this Mac. Restore the Keychain key and Retry, or Reset to start fresh." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Encrypted, but the storage key is unavailable on this Mac. Restore the Keychain key and Retry, or Reset to start fresh."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화되었지만 이 Mac에서 저장소 키를 사용할 수 없습니다. 키체인 키를 복원하고 다시 시도하거나, 재설정하여 새로 시작하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зашифровано, но ключ хранения недоступен на этом Mac. Восстановите ключ связки ключей и повторите попытку или выполните сброс, чтобы начать все заново."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密，但此 Mac 上无法使用存储密钥。恢复钥匙串密钥并重试，或重置以重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密，但此Mac上無法使用存儲密鑰。恢復鑰匙串密鑰並重試，或重置以重新開始。"
          }
        }
      }
    },
