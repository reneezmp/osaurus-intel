            "state" : "translated",
            "value" : "Bonjour로 로컬 네트워크에 이 에이전트를 알려 주변 기기가 자동으로 찾을 수 있게 합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объявлять этого агента в локальной сети через Bonjour, чтобы устройства рядом находили его автоматически."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Bonjour 在本地网络中公布此智能体，以便附近的设备可以自动发现它。"
          }
        }
      }
    },
    "Affects pause detection, wake word detection, and voice activity thresholds" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beeinflusst Pausenerkennung, Aktivierungswort-Erkennung und Sprachaktivitätsschwellen"
