    "Runs in an isolated Linux VM with no access to host files or credentials. Outbound network is on by default and can be turned off per agent in the agent's Sandbox settings.": {
      "comment": "An explanatory label for the \"Sandbox\" execution host option in the Providers view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4uft in einer isolierten Linux-VM ohne Zugriff auf Host-Dateien oder Anmeldedaten. Ausgehendes Netzwerk ist standardm\u00e4\u00dfig aktiviert und kann pro Agent in den Sandbox-Einstellungen des Agenten deaktiviert werden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u9694\u79bb\u7684 Linux \u865a\u62df\u673a\u4e2d\u8fd0\u884c\uff0c\u65e0\u6cd5\u8bbf\u95ee\u4e3b\u673a\u6587\u4ef6\u6216\u51ed\u636e\u3002\u51fa\u7ad9\u7f51\u7edc\u9ed8\u8ba4\u5f00\u542f\uff0c\u53ef\u5728\u667a\u80fd\u4f53\u7684\u6c99\u76d2\u8bbe\u7f6e\u4e2d\u6309\u667a\u80fd\u4f53\u5173\u95ed\u3002"
          }
        }
      }
    },
    "Runs locally \u2014 none of your text touches an external model.": {
      "comment": "Description of a privacy filter benefit: \"Runs locally \u2014 none of your text touches an external model.\"",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4uft lokal \u2013 keiner deiner Texte ber\u00fchrt ein externes Modell."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u672c\u5730\u8fd0\u884c\u2014\u2014\u4f60\u7684\u4efb\u4f55\u6587\u672c\u90fd\u4e0d\u4f1a\u63a5\u89e6\u5916\u90e8\u6a21\u578b\u3002"
          }
        }
      }
    },
