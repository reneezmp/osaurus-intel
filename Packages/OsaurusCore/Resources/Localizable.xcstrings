    "Port, network exposure, CORS, top-P, model eviction, and idle residency now live in Server \u2192 Settings, backed by the vmlx server-runtime contract.": {
      "comment": "A description of the changes to the Server/Local",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Port, Netzwerkfreigabe, CORS, top-P, Modell-Eviction und Leerlauf-Residenz befinden sich jetzt unter Server \u2192 Einstellungen, gest\u00fctzt auf den vmlx-Server-Runtime-Vertrag."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7aef\u53e3\u3001\u7f51\u7edc\u66b4\u9732\u3001CORS\u3001top-P\u3001\u6a21\u578b\u9010\u51fa\u548c\u7a7a\u95f2\u9a7b\u7559\u73b0\u5728\u4f4d\u4e8e\u201c\u670d\u52a1\u5668 \u2192 \u8bbe\u7f6e\u201d\u4e2d\uff0c\u7531 vmlx \u670d\u52a1\u5668\u8fd0\u884c\u65f6\u5951\u7ea6\u63d0\u4f9b\u652f\u6301\u3002"
          }
        }
      }
    },
    "Power & Sleep": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Power & Sleep"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7535\u6e90\u4e0e\u7761\u7720"
          }
        }
      }
    },
    "Powered by FluidAudio PocketTTS. English only. Streams audio as it's synthesized.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterst\u00fctzt von FluidAudio PocketTTS. Nur Englisch. Streamt Audio w\u00e4hrend der Synthese."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7531 FluidAudio PocketTTS \u63d0\u4f9b\u652f\u6301\u3002\u4ec5\u652f\u6301\u82f1\u8bed\u3002\u5728\u5408\u6210\u7684\u540c\u65f6\u6d41\u5f0f\u64ad\u653e\u97f3\u9891\u3002"
          }
        }
      }
    },
    "Pre-flight picks the most relevant per turn.": {
      "localizations": {
