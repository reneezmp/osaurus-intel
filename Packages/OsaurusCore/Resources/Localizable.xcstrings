          }
        }
      }
    },
    "The 256-bit encryption key lives in your macOS Keychain. It never leaves this Mac and is not synced to iCloud." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The 256-bit encryption key lives in your macOS Keychain. It never leaves this Mac and is not synced to iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "256位加密密钥存储在您的macOS钥匙串中。它永远不会离开这台Mac，并且不会同步到iCloud。"
          }
        }
      }
    },
    "The agent adds rows when it has something to remember. You can also ask it directly in chat, or import a file." : {
      "comment" : "Description of what happens when a table is empty.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The agent adds rows when it has something to remember. You can also ask it directly in chat, or import a file."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The agent adds rows when it has something to remember. You can also ask it directly in chat, or import a file."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The agent adds rows when it has something to remember. You can also ask it directly in chat, or import a file."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能体在有需要记住的内容时会添加行。你也可以直接在聊天中询问，或导入文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能體在有需要記住的內容時會新增行。你也可以直接在聊天中詢問，或匯入檔案。"
          }
        }
      }
    },
    "The agent adds rows with `db_insert` / `db_upsert` when it has something to remember. You can also ask it directly in chat." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent fügt mit `db_insert` / `db_upsert` Zeilen hinzu, wenn er sich etwas merken möchte. Du kannst ihn auch direkt im Chat fragen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当智能体有需要记住的内容时，会使用 `db_insert` / `db_upsert` 添加行。你也可以在聊天中直接请求它。"
          }
        }
      }
    },
    "The agent designs this layout itself with the `db_create_table` tool. Ask it in chat if you want new columns." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The agent designs this layout itself with the `db_create_table` tool. Ask it in chat if you want new columns."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The agent designs this layout itself with the `db_create_table` tool. Ask it in chat if you want new columns."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The agent designs this layout itself with the `db_create_table` tool. Ask it in chat if you want new columns."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能体使用 `db_create_table` 工具自行设计此布局。如果需要新列，请在聊天中询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能體使用 `db_create_table` 工具自行設計此佈局。如果需要新列，請在聊天中詢問。"
          }
        }
      }
    },
    "The agent determines the AI's behavior and available tools." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Agent bestimmt das Verhalten der KI und die verfügbaren Tools."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理决定人工智能的行为和可用工具。"
          }
        }
      }
    },
    "The agent is writing to its database right now." : {
      "comment" : "Tooltip text for the \"in-flight mutation spinner\" in the Database workspace.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The agent is writing to its database right now."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "The agent is writing to its database right now."
          }
        },
        "ru" : {
          "stringUnit" : {
