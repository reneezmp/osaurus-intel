    "%@ needs you to sign in again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ erfordert eine erneute Anmeldung."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 다시 로그인해야 합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ просит войти снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要您重新登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要您重新登入。"
          }
        }
      }
    },
    "%@ no longer need a plugin. Already turned on for %@; for other agents use Agents → Overview → Apple Apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ brauchen kein Plug-in mehr. Bereits eingeschaltet für %2$@; für andere Agenten unter Agenten → Übersicht → Apple-Apps."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 이제 플러그인이 필요 없습니다. %@에 이미 켜져 있습니다. 다른 에이전트는 에이전트 → 개요 → Apple 앱에서 켜세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ больше не требуют плагина. Уже включено для %@; для других агентов используйте Агенты → Обзор → Приложения Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 不再需要插件。已为 %2$@ 开启；其他智能体请前往“智能体 → 概述 → Apple 应用”。"
          }
        }
      }
    },
    "%@ no longer need a plugin. Turn each app on per agent under Agents → Overview → Apple Apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ brauchen kein Plug-in mehr. Schalte jede App pro Agent unter Agenten → Übersicht → Apple-Apps ein."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 이제 플러그인이 필요 없습니다. 에이전트 → 개요 → Apple 앱에서 에이전트별로 각 앱을 켜세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ больше не требуют плагина. Включайте каждое приложение для агента в разделе Агенты → Обзор → Приложения Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不再需要插件。请在“智能体 → 概述 → Apple 应用”中为每个智能体开启相应应用。"
          }
        }
      }
    },
