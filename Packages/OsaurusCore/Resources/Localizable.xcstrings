      }
    },
    "Runs on this Mac. Audio never leaves it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft auf diesem Mac. Der Ton verlässt ihn nie."
